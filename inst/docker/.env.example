# Copiare in .env e modificare (il file .env NON va messo in git)
POSTGRES_DB=spatiotemporal
POSTGRES_USER=ecor
POSTGRES_PASSWORD=cambiami-con-una-password-lunga

# true = comprime i chunk TimescaleDB più vecchi di 1 anno dopo il caricamento
STDB_COMPRESS=false

# 127.0.0.1 = solo localhost (consigliato, accesso via tunnel SSH); 0.0.0.0 = aperto
STDB_BIND=127.0.0.1
STDB_PORT=5432

# Memoria: circa 25% / 75% della RAM disponibile per il container
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_MAINTENANCE_WORK_MEM=512MB
